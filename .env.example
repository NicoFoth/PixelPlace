# Copy this file to .env; docker compose reads it automatically.

# Canvas size in pixels (max 4096). The canvas can grow later; shrinking is refused.
WIDTH=1000
HEIGHT=1000

# Seconds each IP address waits between pixels.
COOLDOWN_SECONDS=60

# Port on the host for docker-compose.yml.
PORT=8080

# For docker-compose.https.yml only: the domain pointing at this machine.
# Caddy gets a certificate for it automatically.
DOMAIN=place.example.com
